<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <!-- The generator already places the artwork inside the 66/108 safe zone
       on a transparent canvas, so no extra inset here (an inset on top would
       shrink the moon twice and leave it lost in the middle). -->
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
  <!-- Monochrome layer: Android 12+/13+ launchers tint this silhouette with
       the user's wallpaper colours (Material You), so the icon adapts to the
       phone theme instead of staying a fixed purple. -->
  <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
